# ==========================================
# Telegram API Credentials (from https://my.telegram.org)
# ==========================================
API_ID=
API_HASH=

# ==========================================
# Telegram Bot Token (from @BotFather)
# ==========================================
BOT_TOKEN=

# ==========================================
# Bot Owner Telegram User ID (numeric, from @userinfobot)
# ==========================================
BOT_OWNER=

# ==========================================
# MongoDB Database URI (from https://mongodb.com)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# ==========================================
DATABASE_URI=
DATABASE_NAME=Cluster0

# ==========================================
# Optional: Pre-configured Pyrogram String Session
# (Starts with BQED...)
# ==========================================
STRING_SESSION=

# ==========================================
# Auto-Rebranding Target Channel
# ==========================================
CHANNEL_USERNAME=@moviesguardianss

# ==========================================
# Forwarding Delay in seconds (Anti-Flood)
# ==========================================
FORWARD_SLEEP=1.8
